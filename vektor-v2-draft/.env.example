# ---------- Browser-safe (apps/web/.env.local) ----------
NEXT_PUBLIC_SUPABASE_URL=https://oqhtfryngcnbvisfsctl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=            # Supabase > Project Settings > API > anon / publishable key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_TOKEN=                 # public pk.* token, restrict by URL in Mapbox

# ---------- Server-only (NEVER expose in browser / mobile code) ----------
SUPABASE_SERVICE_ROLE_KEY=                # Supabase > Project Settings > API > service_role
TRACCAR_WEBHOOK_SECRET=                   # long random string, also set in Traccar forwarding header
CRON_SECRET=                              # long random string for /api/cron/checks
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
AI_DAILY_LIMIT_PER_USER=50
MAINTENANCE_MODE=0                        # set to 1 to show the maintenance page
# REDIS_URL=                              # planned (BullMQ workers) - not used yet

# ---------- Mobile (apps/mobile/.env) ----------
EXPO_PUBLIC_SUPABASE_URL=https://oqhtfryngcnbvisfsctl.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
