# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=

# Server-only Supabase key. Never expose this to browser/mobile.
SUPABASE_SERVICE_ROLE_KEY=

# Maps
NEXT_PUBLIC_MAPBOX_TOKEN=

# Traccar webhook shared secret (only after Traccar server is deployed)
TRACCAR_WEBHOOK_SECRET=

# Optional background workers (not active until a worker is deployed)
REDIS_URL=

# AI provider fallback chain (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Payment provider credentials are intentionally omitted until a Zimbabwe-capable provider is selected.
